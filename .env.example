# ============================================
# KalaChat — Environment Variables
# ============================================
# Copy this file to .env for local development.
# For production on Netlify, set ALL vars below
# in the Netlify dashboard (Site > Environment variables).
#
# Netlify function (server-side proxy) uses:
#   API_KEY_OPENROUTER, API_KEY_GEMINI, API_KEY_PRO
# ============================================

VITE_DEFAULT_MODE=free

# === OpenRouter (Free) ===
VITE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VITE_OPENROUTER_API_KEY=sk-or-placeholder
VITE_OPENROUTER_MODEL_FREE=openrouter/free
VITE_OPENROUTER_MODEL_NEMOTRON=nvidia/nemotron-3-super-120b-a12b:free
VITE_OPENROUTER_MODEL_GPTOSS=openai/gpt-oss-120b:free
VITE_OPENROUTER_MODEL_MINIMAX=minimax/minimax-m2.5:free
VITE_OPENROUTER_MODEL_DOLPHIN=cognitivecomputations/dolphin-mistral-24b-venice-edition:free

# === Gemini Flash (Free) ===
VITE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
VITE_GEMINI_API_KEY=AIza-placeholder
VITE_GEMINI_MODEL=gemini-2.0-flash

# === DeepSeek (PRO - Paid) ===
VITE_PRO_BASE_URL=https://api.deepseek.com
VITE_PRO_API_KEY=sk-placeholder
VITE_PRO_MODEL_V4=deepseek-chat
VITE_PRO_MODEL_V4_PRO=deepseek-reasoner
