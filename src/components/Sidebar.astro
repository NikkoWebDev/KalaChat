---

---

<aside
  id="sidebar"
  role="navigation"
  aria-label="Conversaciones"
  class="fixed inset-y-0 left-0 z-50 flex w-[86%] max-w-[330px] shrink-0 -translate-x-full flex-col
    border-r border-[color:var(--linea)] bg-[color:var(--bg-alt)]
    transition-transform duration-300 ease-[cubic-bezier(.22,1,.36,1)]
    lg:relative lg:w-[290px] lg:translate-x-0
    [.sidebar-open_&]:translate-x-0"
>
  <div class="flex items-center gap-2.5 px-4 pb-3.5 pt-[calc(1rem+env(safe-area-inset-top,0px))]">
    <div class="grid h-9 w-9 shrink-0 place-items-center rounded-xl brand-mark">
      <svg width="17" height="17" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 2l1.9 5.1L17 9l-5.1 1.9L10 16l-1.9-5.1L3 9l5.1-1.9z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
    </div>
    <div class="min-w-0 flex-1 leading-tight">
      <p class="truncate text-[15px] font-bold tracking-tight">Reprebot</p>
      <p class="truncate text-[11px]" style="color:var(--fg-suave)">Consejo de Estudiantes · Ing. Sistemas</p>
    </div>
    <button id="cerrar-sidebar" type="button" class="icon-btn lg:hidden" aria-label="Cerrar menú">
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </button>
  </div>

  <div class="px-3 pb-3">
    <button id="nueva-conv" type="button" class="flex w-full items-center gap-2 rounded-xl border border-[color:var(--linea)] px-3.5 py-2.5 text-[13px] font-semibold transition-colors hover:border-[color:var(--acento)] hover:text-[color:var(--acento)]">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      Nueva conversación
    </button>
  </div>

  <div class="px-3 pb-2">
    <label class="relative block">
      <span class="sr-only">Buscar en el historial</span>
      <svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="color:var(--fg-suave)">
        <circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.4"/>
        <path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
      <input id="buscar" type="search" placeholder="Buscar" autocomplete="off"
        class="w-full rounded-xl border border-[color:var(--linea)] bg-transparent py-2 pl-9 pr-3 text-[13px] outline-none placeholder:text-[color:var(--fg-suave)] focus:border-[color:var(--acento)]" />
    </label>
  </div>

  <div id="lista" class="flex-1 overflow-y-auto overflow-x-hidden px-2 pb-2"></div>

  <div class="border-t border-[color:var(--linea)] px-3 py-3 pb-[calc(.75rem+env(safe-area-inset-bottom,0px))]">
    <button id="btn-ajustes" type="button" class="flex w-full items-center gap-2.5 rounded-xl px-3 py-2.5 text-[13px] font-medium transition-colors hover:bg-[color:var(--card)]" style="color:var(--fg-suave)">
      <svg width="17" height="17" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="2.6" stroke="currentColor" stroke-width="1.4"/><path d="M10 2.5v2M10 15.5v2M2.5 10h2M15.5 10h2M4.7 4.7l1.4 1.4M13.9 13.9l1.4 1.4M15.3 4.7l-1.4 1.4M6.1 13.9l-1.4 1.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      Configuración
    </button>
  </div>
</aside>

<div id="velo" class="fixed inset-0 z-40 hidden bg-[color:var(--c-noche)]/70 backdrop-blur-sm lg:hidden" aria-hidden="true"></div>