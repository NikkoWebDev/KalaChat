---
---

<header id="header" class="flex items-center justify-between px-3 py-2 pt-[calc(8px+env(safe-area-inset-top,0px))] border-b border-surface-800 bg-surface z-10 shrink-0 min-h-[52px] lg:px-6 lg:py-2.5 lg:pt-[calc(10px+env(safe-area-inset-top,0px))]">
  <div class="flex items-center gap-2">
    <button id="menu-btn" class="w-9 h-9 rounded-[10px] flex items-center justify-center text-surface-200 hover:bg-gold/10 hover:text-gold transition-all duration-200 lg:hidden" aria-label="Abrir menú" title="Menú">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M3 11h16M3 6h16M3 16h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </button>
    <div class="flex items-center gap-2">
      <div class="w-7 h-7 rounded-lg bg-gold/10 text-gold flex items-center justify-center font-display text-[15px] font-bold">K</div>
      <span class="text-base font-bold tracking-tight">KalaChat</span>
    </div>
  </div>

  <div class="flex items-center gap-1.5">
    <div class="flex bg-surface-400 rounded-[10px] p-0.5 border border-surface-800" role="radiogroup" aria-label="Modo de modelo">
      <button class="mode-btn flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-semibold text-surface-300 transition-all duration-250 tracking-wide active" data-mode="free" role="radio" aria-checked="true" aria-label="Modo gratuito">
        <span class="w-1.5 h-1.5 rounded-full inline-block bg-surface-300 mode-dot free-dot"></span>
        Free
      </button>
      <button class="mode-btn flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-semibold text-surface-300 transition-all duration-250 tracking-wide" data-mode="pro" role="radio" aria-checked="false" aria-label="Modo profesional">
        <span class="w-1.5 h-1.5 rounded-full inline-block bg-surface-300 mode-dot pro-dot"></span>
        PRO
      </button>
    </div>
    <button id="theme-btn" class="w-9 h-9 rounded-[10px] flex items-center justify-center text-surface-200 hover:bg-gold/10 hover:text-gold transition-all duration-200" aria-label="Cambiar tema" title="Tema">
      <svg class="theme-sun" width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="3.5" stroke="currentColor" stroke-width="1.5"/><path d="M10 1v2M10 17v2M1 10h2M17 10h2M3.93 3.93l1.41 1.41M14.66 14.66l1.41 1.41M3.93 16.07l1.41-1.41M14.66 5.34l1.41-1.41" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      <svg class="theme-moon" width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M17.293 13.293A8 8 0 016.707 2.707a8 8 0 1010.586 10.586z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>
</header>
