---

---

<header class="relative z-10 flex shrink-0 items-center gap-2 border-b border-[color:var(--linea)] px-3 py-2 pt-[calc(.6rem+env(safe-area-inset-top,0px))] lg:px-5">
  <button id="menu-btn" type="button" class="icon-btn lg:hidden" aria-label="Abrir menú">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  </button>

  <div class="flex min-w-0 flex-1 items-center gap-2.5 lg:hidden">
    <div class="grid h-8 w-8 shrink-0 place-items-center rounded-lg brand-mark">
      <svg width="15" height="15" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 2l1.9 5.1L17 9l-5.1 1.9L10 16l-1.9-5.1L3 9l5.1-1.9z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
    </div>
    <p class="truncate text-[15px] font-bold tracking-tight">Reprebot</p>
  </div>

  <div class="hidden min-w-0 flex-1 items-center gap-2 lg:flex">
    <p class="truncate text-[13px]" style="color:var(--fg-suave)">
      Asistente del <span class="font-semibold" style="color:var(--fg)">CEIS</span> · documentos y normativa UNAL
    </p>
  </div>

  <div class="flex items-center gap-1">
    <button id="exportar-md" type="button" class="icon-btn" aria-label="Exportar a Markdown" title="Exportar a Markdown">
      <svg width="17" height="17" viewBox="0 0 20 20" fill="none"><path d="M10 3v9m0 0l-3.2-3.2M10 12l3.2-3.2M4 15.5h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <a href="https://ingenieria.bogota.unal.edu.co" target="_blank" rel="noopener noreferrer" class="icon-btn hidden sm:grid" aria-label="Sitio de la Facultad de Ingeniería" title="Facultad de Ingeniería">
      <svg width="17" height="17" viewBox="0 0 20 20" fill="none"><path d="M8 4h8v8M16 4l-7 7M13 12v4H4V7h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</header>