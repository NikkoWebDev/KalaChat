---

---

<div class="shrink-0 px-3 pb-[calc(.6rem+env(safe-area-inset-bottom,0px))] pt-2 lg:px-6">
  <div class="mx-auto max-w-[52rem]">

    <div id="chips" class="mb-2 flex flex-wrap gap-1.5 px-1" hidden></div>

    <div class="mb-1.5 flex items-center gap-2 px-1">
      <button id="modelo-btn" type="button"
        class="flex min-w-0 shrink items-center gap-2 rounded-lg px-2 py-1 text-[11.5px] font-medium transition-colors hover:bg-[color:var(--card)]"
        aria-haspopup="listbox" aria-expanded="false" aria-label="Elegir modelo">
        <svg class="shrink-0" width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="color:var(--acento)">
          <path d="M8 1.5l1.6 4.1 4.1 1.6-4.1 1.6L8 12.9l-1.6-4.1L2.3 7.2l4.1-1.6z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
        </svg>
        <span id="modelo-label" class="truncate font-semibold">Reprebot</span>
        <span id="modelo-sello" class="hidden shrink-0 sello-gratis sm:inline">Documental</span>
        <svg class="shrink-0" width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>

      <div class="ml-auto flex shrink-0 items-center gap-2.5">
        <label class="switch" title="Razonar antes de responder">
          <span class="switch-track" id="thinking-track" data-on="true" role="switch" tabindex="0" aria-label="Modo razonamiento">
            <span class="switch-thumb"></span>
          </span>
          <span class="switch-label hidden sm:inline" id="thinking-label" data-on="true">Razonamiento</span>
        </label>
      </div>
    </div>

    <div class="composer">
      <button id="adjuntar" type="button" class="icon-btn" aria-label="Adjuntar archivo de texto" title="Adjuntar archivo">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M12.5 7.5l-5 5a2 2 0 002.83 2.83l5.7-5.7a4 4 0 10-5.66-5.66L4.2 9.14a5 5 0 000 7.07" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <input id="archivos" type="file" class="hidden" multiple
        accept=".txt,.md,.json,.csv,.log,.yml,.yaml,.xml,.html,.css,.js,.ts,.jsx,.tsx,.py,.java,.c,.h,.cpp,.go,.rs,.rb,.php,.sql,.sh,.kt,.swift,.toml,.ini,.conf,.env" />

      <textarea id="input" rows="1" placeholder="Pregunta lo que necesites…"
        class="max-h-[200px] flex-1 bg-transparent py-2 text-[15px] leading-relaxed outline-none placeholder:text-[color:var(--fg-suave)]"
        aria-label="Mensaje"></textarea>

      <button id="enviar" type="button" class="send-btn" aria-label="Enviar mensaje" disabled>
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M2.5 10L17 3.5 12 16l-2.6-4.6L2.5 10z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
      </button>
    </div>

    <p class="mt-1.5 select-none px-1 text-center text-[10.5px]" style="color:var(--fg-suave)">
      Reprebot cita sus fuentes. Verifica lo crítico con la Secretaría de la Facultad.
    </p>
  </div>

  <div id="menu-modelos" class="glass-strong fixed z-[120] hidden max-h-[70vh] w-[290px] overflow-y-auto rounded-2xl p-1.5 animate-dropdown-in" role="listbox" aria-label="Modelos"></div>
</div>