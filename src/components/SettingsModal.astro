---

---

<div id="modal-ajustes" class="modal-overlay fixed inset-0 z-[200] hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="ajustes-titulo">
  <div class="modal-backdrop absolute inset-0 bg-[color:var(--c-noche)]/70 backdrop-blur-md"></div>

  <div class="glass-strong relative flex max-h-[90vh] w-full max-w-[540px] flex-col rounded-2xl px-6 pb-5 pt-5 animate-modal-in">
    <div class="mb-5 flex shrink-0 items-center justify-between gap-3">
      <h3 id="ajustes-titulo" class="text-[17px] font-bold tracking-tight">Configuración</h3>
      <button id="cerrar-ajustes" type="button" class="icon-btn" aria-label="Cerrar">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
    </div>

    <div class="settings-scroll space-y-6 overflow-y-auto pr-1">
      <section style="border-left:2px solid var(--acento);padding-left:14px">
        <h4 class="mb-2 text-[13px] font-semibold">Modelo activo</h4>
        <div id="info-modelo" class="rounded-xl border border-[color:var(--linea)] px-3.5 py-3 text-[13px]"></div>
      </section>

      <section style="border-left:2px solid var(--linea);padding-left:14px">
        <h4 class="mb-2 text-[13px] font-semibold">Recuperación de fuentes</h4>
        <p class="mb-3 text-[12px] leading-relaxed" style="color:var(--fg-suave)">
          Cuántos fragmentos de documento consulta Reprebot antes de responder. Más fragmentos dan más contexto
          y una respuesta más lenta.
        </p>
        <div class="flex items-center gap-3">
          <input id="k-fuentes" type="range" min="1" max="20" step="1" value="5" class="h-1 flex-1 accent-[color:var(--acento)]" aria-label="Fragmentos recuperados" />
          <span id="k-valor" class="w-6 text-center font-mono text-[13px] tabular-nums">5</span>
        </div>
      </section>

      <section style="border-left:2px solid var(--linea);padding-left:14px">
        <h4 class="mb-2 text-[13px] font-semibold">Razonamiento</h4>
        <p class="mb-3 text-[12px] leading-relaxed" style="color:var(--fg-suave)">
          Con el modo activo el modelo piensa antes de contestar. Aplica a los modelos de propósito general,
          no a Reprebot.
        </p>
        <label class="switch">
          <span id="ajustes-thinking-track" class="switch-track" data-on="true" role="switch" tabindex="0" aria-label="Modo razonamiento">
            <span class="switch-thumb"></span>
          </span>
          <span id="ajustes-thinking-label" class="switch-label" data-on="true">Razonamiento</span>
        </label>
      </section>

      <section style="border-left:2px solid var(--linea);padding-left:14px">
        <h4 class="mb-2 text-[13px] font-semibold">Tema</h4>
        <div class="flex gap-2">
          <button type="button" data-tema="dark" class="opcion-tema flex flex-1 items-center gap-2 rounded-xl border px-3.5 py-2.5 text-[13px] font-medium transition-colors" style="border-color:var(--linea)">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><path d="M13.5 10.5A6 6 0 015.5 2.5a6 6 0 1010 8z" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
            Noche
          </button>
          <button type="button" data-tema="light" class="opcion-tema flex flex-1 items-center gap-2 rounded-xl border px-3.5 py-2.5 text-[13px] font-medium transition-colors" style="border-color:var(--linea)">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.3"/><path d="M8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3.2 3.2l1 1M11.8 11.8l1 1M12.8 3.2l-1 1M4.2 11.8l-1 1" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
            Papel
          </button>
        </div>
      </section>

      <section style="border-left:2px solid var(--linea);padding-left:14px">
        <h4 class="mb-2 text-[13px] font-semibold">Claves de API</h4>
        <p class="mb-3 text-[12px] leading-relaxed" style="color:var(--fg-suave)">
          Se guardan solo en este navegador. Reprebot funciona sin clave propia: el servidor del CEIS pone la suya.
        </p>

        <label for="clave-reprebot" class="mb-1 block text-[12px] font-medium">Reprebot (X-Api-Key)</label>
        <input id="clave-reprebot" type="password" autocomplete="off" placeholder="opcional"
          class="mb-3 w-full rounded-xl border border-[color:var(--linea)] bg-transparent px-3.5 py-2.5 text-[13px] outline-none placeholder:text-[color:var(--fg-suave)] focus:border-[color:var(--acento)]" />

        <label for="clave-openrouter" class="mb-1 block text-[12px] font-medium">OpenRouter</label>
        <input id="clave-openrouter" type="password" autocomplete="off" placeholder="sk-or-…"
          class="mb-3 w-full rounded-xl border border-[color:var(--linea)] bg-transparent px-3.5 py-2.5 text-[13px] outline-none placeholder:text-[color:var(--fg-suave)] focus:border-[color:var(--acento)]" />

        <label for="clave-gemini" class="mb-1 block text-[12px] font-medium">Gemini</label>
        <input id="clave-gemini" type="password" autocomplete="off" placeholder="AIza…"
          class="mb-3 w-full rounded-xl border border-[color:var(--linea)] bg-transparent px-3.5 py-2.5 text-[13px] outline-none placeholder:text-[color:var(--fg-suave)] focus:border-[color:var(--acento)]" />

        <label for="clave-pro" class="mb-1 block text-[12px] font-medium">PRO (DeepSeek)</label>
        <input id="clave-pro" type="password" autocomplete="off" placeholder="sk-…"
          class="w-full rounded-xl border border-[color:var(--linea)] bg-transparent px-3.5 py-2.5 text-[13px] outline-none placeholder:text-[color:var(--fg-suave)] focus:border-[color:var(--acento)]" />
      </section>

      <section style="border-left:2px solid var(--linea);padding-left:14px">
        <h4 class="mb-2 text-[13px] font-semibold">Atajos</h4>
        <div class="grid grid-cols-[1fr_auto] gap-x-4 gap-y-2 text-[12px]">
          <span style="color:var(--fg-suave)">Enviar</span><kbd class="tecla">Enter</kbd>
          <span style="color:var(--fg-suave)">Nueva línea</span><kbd class="tecla">Shift + Enter</kbd>
          <span style="color:var(--fg-suave)">Nueva conversación</span><kbd class="tecla">Ctrl + Shift + O</kbd>
          <span style="color:var(--fg-suave)">Buscar en el historial</span><kbd class="tecla">Ctrl + K</kbd>
          <span style="color:var(--fg-suave)">Enfocar el compositor</span><kbd class="tecla">/</kbd>
          <span style="color:var(--fg-suave)">Detener la generación</span><kbd class="tecla">Esc</kbd>
        </div>
      </section>

      <section style="border-left:2px solid var(--linea);padding-left:14px">
        <h4 class="mb-2 text-[13px] font-semibold">Datos</h4>
        <div class="flex flex-wrap gap-2">
          <button id="exportar-json" type="button" class="rounded-xl border border-[color:var(--linea)] px-3.5 py-2 text-[12px] font-medium transition-colors hover:border-[color:var(--acento)] hover:text-[color:var(--acento)]">
            Exportar JSON
          </button>
          <button id="limpiar-datos" type="button" class="rounded-xl border px-3.5 py-2 text-[12px] font-medium transition-colors" style="border-color:color-mix(in srgb, #EF4444 40%, transparent);color:#EF4444">
            Borrar todo
          </button>
        </div>
      </section>

      <section style="border-left:2px solid var(--linea);padding-left:14px">
        <h4 class="mb-1 text-[13px] font-semibold">Acerca de</h4>
        <p class="text-[12px] leading-relaxed" style="color:var(--fg-suave)">
          Reprebot es el asistente del Consejo de Estudiantes de Ingeniería de Sistemas de la Universidad Nacional
          de Colombia, sede Bogotá. Corre sobre Kala AI 4.3 y responde con los documentos indexados del programa
          y de la normativa institucional. El historial vive en su navegador.
        </p>
      </section>
    </div>

    <div class="mt-5 flex shrink-0 justify-end gap-2 border-t border-[color:var(--linea)] pt-4">
      <button id="guardar-ajustes" type="button" class="rounded-xl px-5 py-2.5 text-[13px] font-semibold" style="background:var(--acento);color:var(--c-noche)">
        Guardar
      </button>
    </div>
  </div>
</div>