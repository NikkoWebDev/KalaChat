---
import '../styles/base.css'

interface Props {
  title?: string
}
const { title = 'Reprebot · Asistente del CEIS' } = Astro.props

// Canonical production origin, no trailing slash.
const SITE = 'https://repre.nikko.dev'
const DESCRIPTION =
  'Reprebot, el asistente del Consejo de Estudiantes de Ingeniería de Sistemas. Resuelve dudas sobre el plan de estudios, la malla curricular y la normativa de la UNAL.'
---

<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#0E1F1B" id="theme-color-meta" />
  <meta name="description" content={DESCRIPTION} />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Reprebot" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="icon" type="image/png" sizes="64x64" href="/logo-64.png" />
  <link rel="apple-touch-icon" href="/logo-180.png" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://repre.nikko.dev/" />
  <meta property="og:title" content="Reprebot · Asistente del CEIS" />
  <meta property="og:description" content={DESCRIPTION} />
  <meta property="og:image" content="https://repre.nikko.dev/logo-512.png" />
  <meta property="og:image:width" content="512" />
  <meta property="og:image:height" content="512" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Reprebot · Asistente del CEIS" />
  <meta name="twitter:image" content="https://repre.nikko.dev/logo-512.png" />
  <title>{title}</title>
</head>
<body>
  <slot />
  <script>
    import '../js/app.js'
  </script>
</body>
</html>