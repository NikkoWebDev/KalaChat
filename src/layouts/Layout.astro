---
import '../styles/base.css'

interface Props {
  title?: string
}
const { title = 'Reprebot · Asistente del CEIS' } = Astro.props
const FAVICON = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%2318514A'/%3E%3Cpath d='M32 12l5.2 12.8L50 30l-12.8 5.2L32 48l-5.2-12.8L14 30l12.8-5.2z' fill='%23F6EEE8'/%3E%3C/svg%3E"
---

<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#0E1F1B" id="theme-color-meta" />
  <meta name="description" content="Reprebot, el asistente del Consejo de Estudiantes de Ingeniería de Sistemas. Resuelve dudas sobre el plan de estudios, la malla curricular y la normativa de la UNAL." />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Reprebot" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="icon" type="image/svg+xml" href={FAVICON} />
  <link rel="apple-touch-icon" href={FAVICON} />
  <title>{title}</title>
</head>
<body>
  <slot />
  <script>
    import '../js/app.js'
  </script>
</body>
</html>