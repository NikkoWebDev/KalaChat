---
import Layout from '../layouts/Layout.astro'
import Sidebar from '../components/Sidebar.astro'
import Header from '../components/Header.astro'
import MessagesContainer from '../components/MessagesContainer.astro'
import InputArea from '../components/InputArea.astro'
import SettingsModal from '../components/SettingsModal.astro'
---

<Layout>
  <div id="app" class="relative flex h-dvh w-dvw overflow-hidden" style="background:var(--bg)">
    <Sidebar />
    <main class="relative z-[2] flex h-dvh min-w-0 flex-1 flex-col" style="background:var(--bg)">
      <Header />
      <MessagesContainer />
      <InputArea />
    </main>
  </div>

  <SettingsModal />
</Layout>